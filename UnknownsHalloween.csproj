<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Version>0.1.1.1</Version>
        <Description>Unknown's Halloween - add-on for Unknown's Collection: four full-body Halloween costume hats (Freddy, Jason, Xenomorph, Ghostface) with idle/walk animation and kill cutscenes, plus the Xenomorph role (neutral killer). Built for AU 2024.11.26 / BepInEx 6.0.0-be.697 / Reactor 2.3.1.</Description>
        <Authors>DaUnknown-0</Authors>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <Platforms>AnyCPU</Platforms>
        <AssemblyName>UnknownsHalloween</AssemblyName>
        <RootNamespace>UnknownsHalloween</RootNamespace>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <!-- Same stack as UnknownsCollection (the proven combination for this game install). -->
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2024.10.29" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.697" />
        <PackageReference Include="Reactor" Version="2.3.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Since 2026-10-20 the large artwork is NOT embedded: costume, kill and spider-leg frames (Resources/hats), the
             .atx packs, minigame, intro and eject art of Hollowmere Manor and Ravenhollow Cemetery go into the asset
             repository DaUnknown-0/UnknownsHalloween-Assets (tools/build_assets_repo.py, HalloweenAssets.cs downloads them).
             Embedded stays only what is needed before the download. Keep this list in step with KEEP in
             tools/build_assets_repo.py. Explicit LogicalName so the lookup never depends on the root-namespace default. -->
        <!-- role icons (hats\hw_xenomorph_icon, hw_banshee_icon) -->
        <EmbeddedResource Include="Resources\hats\hw_xenomorph_icon.png;Resources\hats\hw_banshee_icon.png" LogicalName="UnknownsHalloween.Resources.hats.%(Filename)%(Extension)" />
        <!-- Trick or Treat artwork (Grafik-Lieferung 2026-10-20, candy_art.py): 13 candy kinds 256 px (floor shadow baked in),
             the eater's card 640x200 and the menu icon 128 px. Loaded by TreatFx, DXT5 at runtime. -->
        <EmbeddedResource Include="Resources\treats\*.png" LogicalName="UnknownsHalloween.Resources.treats.%(Filename)%(Extension)" />
        <!-- Hollowmere Manor (Atlas map pack, tools/gen_villa.py): flat names, because Atlas looks them up as
             "<ResourceNamespace>.<file>". Embedded: map button and icon, minimaps, eject direction (JSON) and the two
             eject overlays both maps share; floor/props/consoles (.atx, python ../UnknownsAtlas/tools/pack_textures.py
             Resources/villa villa), minigames, intro and eject art come with the asset packages. -->
        <EmbeddedResource Include="Resources\villa\button_villa.png;Resources\villa\icon_villa.png;Resources\villa\villa_minimap_*.png;Resources\villa\task_eject_*.png;Resources\villa\*.json;Resources\villa\*.wav"
                          LogicalName="UnknownsHalloween.Resources.%(Filename)%(Extension)" />
        <!-- Ravenhollow Cemetery (Atlas map file, tools/gen_graveyard.py): map.json, button, icon and minimap embedded,
             the .atx packs (python ../UnknownsAtlas/tools/pack_textures.py Resources/graveyard graveyard) and the minigame
             art come with the asset packages. -->
        <EmbeddedResource Include="Resources\graveyard\map.json;Resources\graveyard\button_graveyard.png;Resources\graveyard\icon_graveyard.png;Resources\graveyard\graveyard_minimap.png"
                          LogicalName="UnknownsHalloween.Resources.graveyard.%(Filename)%(Extension)" />
        <!-- Ravenhollow eject scenes (tools/gen_graveyard_eject.py + tools/graveyard_eject.py): the direction (JSON) is
             embedded, the pictures come with the asset packages. Flat like the villa (EjectEngine looks under
             UnknownsHalloween.Resources.<file>). -->
        <EmbeddedResource Include="Resources\graveyard_eject\*.json" LogicalName="UnknownsHalloween.Resources.%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- DLL locations: default to the local builds, overridable via -p:TheOtherRolesDll=... / -p:UnknownsCollectionDll=... -->
    <PropertyGroup>
        <TheOtherRolesDll Condition="'$(TheOtherRolesDll)' == ''">..\TheOtherRoles-main\TheOtherRoles-main\TheOtherRoles\bin\Debug\net6.0\TheOtherRoles.dll</TheOtherRolesDll>
        <UnknownsCollectionDll Condition="'$(UnknownsCollectionDll)' == ''">..\UnknownsCollection\bin\Debug\net6.0\UnknownsCollection.dll</UnknownsCollectionDll>
        <UnknownsAtlasDll Condition="'$(UnknownsAtlasDll)' == ''">..\UnknownsAtlas\bin\Release\net6.0\UnknownsAtlas.dll</UnknownsAtlasDll>
    </PropertyGroup>

    <!-- Soft dependency: Unknown's Atlas (public AtlasMaps API) for the Hollowmere Manor map. Only
         HollowmereMap and the generated Villa*.g.cs touch it; without Atlas the map is not registered. -->
    <ItemGroup>
        <Reference Include="UnknownsAtlas">
            <HintPath>$(UnknownsAtlasDll)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Hard dependencies: TOR (CustomOption, RoleInfo, Helpers, ...) and Unknown's Collection
         (UCRpc, UCFx, UCPromotion, UCRoleDraft, the hat bounce helper, ...). -->
    <ItemGroup>
        <Reference Include="TheOtherRoles">
            <HintPath>$(TheOtherRolesDll)</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnknownsCollection">
            <HintPath>$(UnknownsCollectionDll)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="CopyCustomContent" AfterTargets="Build" Condition="Exists('$(AmongUsLatest)/BepInEx/plugins/')">
        <Message Text="Copying UnknownsHalloween to BepInEx plugins" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUsLatest)/BepInEx/plugins/" />
    </Target>
</Project>
